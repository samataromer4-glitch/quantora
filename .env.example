# DUGSI PRO 2026 environment template
# Copy the required values into your local .env file or server environment.

# App
# Public HTTPS origin recipients can reach; do not use localhost for emailed links.
APP_URL="https://your-public-app.example"

# Session security
# Use a long random secret in production.
SESSION_SECRET="replace-with-a-long-random-secret"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
# Server-side only. Never include these keys in browser or native app builds.
SUPABASE_SECRET_KEY="your_supabase_secret_key"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"

# Gemini
GEMINI_API_KEY="your_gemini_api_key"

# SMTP (optional; use credentials from your mail provider)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_smtp_email@gmail.com"
SMTP_PASS="your_smtp_app_password"
# Optional permitted sender address; defaults to SMTP_USER or EMAIL_USER.
SMTP_FROM=""
# Legacy aliases accepted when SMTP_USER / SMTP_PASS are not set:
EMAIL_USER=""
EMAIL_PASS=""
