{
  "name": "quantora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "prebuild": "node scripts/generate-png-icons.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "postinstall": "bun run build",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:students-contract": "node scripts/student-module-contract.mjs",
    "test:attendance-contract": "node scripts/attendance-module-contract.mjs",
    "prebuild:mobile": "node scripts/generate-png-icons.cjs",
    "build:mobile": "vite build --mode mobile",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:sync:android": "npm run build:mobile && cap sync android",
    "cap:sync:ios": "npm run build:mobile && cap sync ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "test:mobile-contract": "node scripts/mobile-config-contract.mjs",
    "test:database-source-contract": "node scripts/database-source-contract.mjs",
    "test:finance-source-contract": "node scripts/finance-source-contract.mjs",
    "test:auth-cloud-contract": "node scripts/auth-cloud-source-contract.mjs",
    "test:password-recovery": "node --import tsx --test tests/password-recovery.test.ts && node scripts/password-recovery-contract.mjs",
    "test:tenant-boundary-contract": "node scripts/tenant-boundary-contract.mjs",
    "test:migration-history-contract": "node scripts/migration-history-contract.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/server": "^1.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.13",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1",
    "@capacitor/core": "^8.5.2",
    "@aparajita/capacitor-secure-storage": "^8.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  }
}
